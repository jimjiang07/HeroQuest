{
  "name": "hero-quest",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Daily maths and English quests for young children (phone, tablet, laptop) with printable worksheets.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc -b",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "vitest run && playwright test",
    "pdfs": "node scripts/make-pdfs.mjs",
    "art": "node scripts/make-art.mjs",
    "voice": "node scripts/make-voice.mjs"
  },
  "dependencies": {
    "@fontsource/andika": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
